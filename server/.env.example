# ==============================================================================
# AgentPulse Ops — Production Environment Configuration
# ==============================================================================

# Database Connection (Leave empty or sqlite for zero-config local dev)
# For Postgres production on Render / Supabase / Neon:
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/agentpulse?sslmode=require
DATABASE_URL=sqlite:///./agentpulse.db

# Stripe Billing (https://dashboard.stripe.com/apikeys)
# Leave empty for zero-config simulated sandbox mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Product Price IDs (Optional: create in Stripe Dashboard -> Products)
# If empty, AgentPulse creates dynamic line-items automatically
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Frontend Application Origin
FRONTEND_URL=http://localhost:3032

# Telemetry Server Port & Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

