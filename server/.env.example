# ==============================================================================
# Brenducate — Production Environment Configuration
# ==============================================================================

# Database Connection (Leave empty / sqlite for zero-config local dev)
# For free-tier Postgres on Neon / Supabase / Render:
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/brenducate?sslmode=require
DATABASE_URL=sqlite:///./brenducate.db

# Random 32+ char secret used to sign dashboard session tokens
SESSION_SECRET=change-me-to-a-random-long-secret-string

# Stripe Billing (https://dashboard.stripe.com/apikeys)
# Leave empty for simulated checkout during local development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# Frontend Origin
FRONTEND_URL=http://localhost:3032

# API Port & Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
